# Claude Code keeps roughly half a gigabyte of generated state under ~/.claude.
# Only hand-written config (CLAUDE.md, settings, skills, commands, hooks) and the
# per-project memory directories belong in this repo. Listing the rest here keeps a
# stray `chezmoi add ~/.claude` from hoovering up transcripts and caches.
.claude/backups
.claude/cache
.claude/chrome
.claude/debug
.claude/file-history
.claude/jobs
.claude/paste-cache
.claude/plugins
.claude/session-env
.claude/sessions
.claude/shell-snapshots
.claude/tasks
.claude/telemetry

# projects/ holds session transcripts AND per-project memory. Neither belongs here.
#
# THIS REPO IS PUBLIC. Memory files name internal systems and, in at least one case, which
# secret store holds which production key — so memory is deliberately kept out and lives in
# the private pdjsh/claude-memory repo instead (a git repo rooted at ~/.claude/projects with
# its own allowlist). Do not remove this line to "sync memory too".
.claude/projects

# herdr keeps its runtime state alongside config.toml in ~/.config/herdr: unix sockets,
# a multi-megabyte server log, and per-machine session/plugin state. Only config.toml is
# portable. Listing the rest here keeps a stray `chezmoi add ~/.config/herdr` from
# committing a live socket or a machine's restored-workspace layout.
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/.plugins.lock
.config/herdr/release-notes.json
.config/herdr/session.json

# ~/Library/LaunchAgents is macOS-only. On Linux the git-refresh job would want a
# systemd user timer instead, which does not exist yet — so the plist is simply
# not part of the source state there.
{{ if ne .chezmoi.os "darwin" }}
Library
{{ end }}
